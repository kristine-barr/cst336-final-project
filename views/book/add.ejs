<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head") %>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Book</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="d-flex flex-column min-vh-100">

<!-- Shared navigation -->
<%- include("../partials/nav") %>

<div class="container mt-4 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <!-- Manual Add Book form -->
            <div class="card p-4">

                <h1 class="text-center mb-3">Add Book</h1>

                <p class="text-center">
                    Add a book manually to your bookshelf.
                </p>

                <!-- Sends the entered book information to the server -->
                <form method="POST" action="/book/add">

                    <!-- Book title -->
                    <div class="mb-3 text-start">
                        <label for="title" class="form-label fw-semibold">
                            Title
                        </label>

                        <input
                                type="text"
                                class="form-control"
                                id="title"
                                name="title"
                                required>
                    </div>

                    <!-- Author -->
                    <div class="mb-3 text-start">
                        <label for="author" class="form-label fw-semibold">
                            Author
                        </label>

                        <input
                                type="text"
                                class="form-control"
                                id="author"
                                name="author"
                                required>
                    </div>

                    <!-- ISBN -->
                    <div class="mb-3 text-start">
                        <label for="isbn" class="form-label fw-semibold">
                            ISBN
                        </label>

                        <input
                                type="text"
                                class="form-control"
                                id="isbn"
                                name="isbn">
                    </div>

                    <!-- Publication year -->
                    <div class="mb-3 text-start">
                        <label for="publishYear" class="form-label fw-semibold">
                            Publication Year
                        </label>

                        <input
                                type="number"
                                class="form-control"
                                id="publishYear"
                                name="publishYear"
                                min="0">
                    </div>

                    <!-- Optional cover URL -->
                    <div class="mb-3 text-start">
                        <label for="bookCoverUrl" class="form-label fw-semibold">
                            Cover Image URL
                        </label>

                        <input
                                type="url"
                                class="form-control"
                                id="bookCoverUrl"
                                name="bookCoverUrl">
                    </div>

                    <!-- Submit button -->
                    <button type="submit" class="btn btn-primary w-100">
                        Add Book
                    </button>

                </form>

                <!-- Back to library -->
                <a href="/library" class="mt-3">
                    Back to My Library
                </a>

            </div>

        </div>

    </div>

</div>

<%- include("../partials/footer") %>

</body>

</html>