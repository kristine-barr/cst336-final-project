<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head") %>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Book</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="add-book-page d-flex flex-column min-vh-100">

<%- include("../partials/nav") %>

<div class="container add-book-container">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <div class="add-book-card">

                <h1 class="add-book-title">Add Book</h1>

                <p class="add-book-subtitle">
                    Add a book manually to your bookshelf.
                </p>

                <% if (error) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= error %>
                    </div>
                <% } %>

                <form method="POST" action="/book/add">

                    <div class="mb-3 text-start">
                        <label for="title" class="form-label add-book-label">
                            Title
                        </label>

                        <input
                                type="text"
                                class="form-control add-book-input"
                                id="title"
                                name="title"
                                value="<%= formData.title || '' %>"
                                required>
                    </div>

                    <div class="mb-3 text-start">
                        <label for="author" class="form-label add-book-label">
                            Author
                        </label>

                        <input
                                type="text"
                                class="form-control add-book-input"
                                id="author"
                                name="author"
                                value="<%= formData.author || '' %>"
                                required>
                    </div>

                    <div class="mb-3 text-start">
                        <label for="isbn" class="form-label add-book-label">
                            ISBN
                        </label>

                        <input
                                type="text"
                                class="form-control add-book-input"
                                id="isbn"
                                name="isbn"
                                value="<%= formData.isbn || '' %>">
                    </div>

                    <div class="mb-3 text-start">
                        <label for="publishYear" class="form-label add-book-label">
                            Publication Year
                        </label>

                        <input
                                type="number"
                                class="form-control add-book-input"
                                id="publishYear"
                                name="publishYear"
                                value="<%= formData.publishYear || '' %>"
                                min="0">
                    </div>

                    <div class="mb-3 text-start">
                        <label for="bookCoverUrl" class="form-label add-book-label">
                            Cover Image URL
                        </label>

                        <input
                                type="url"
                                class="form-control add-book-input"
                                id="bookCoverUrl"
                                name="bookCoverUrl"
                                value="<%= formData.bookCoverUrl || '' %>">
                    </div>

                    <button type="submit" class="add-book-button">
                        Add Book
                    </button>

                </form>

                <a href="/library" class="add-book-back-link">
                    Back to My Library
                </a>

            </div>

        </div>

    </div>

</div>

<%- include("../partials/footer") %>

</body>

</html>