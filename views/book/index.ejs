<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Book Search</title>
        <link rel="stylesheet" href="/css/style.css">
</head>

<body class="d-flex flex-column min-vh-100">
    <%- include("../partials/nav") %>
        <% const safeSearch=typeof search !=='undefined' ? search : { title: '' , author: '' }; %>
            <% const safeResults=Array.isArray(results) ? results : []; %>
                <% const safeError=typeof error==='string' ? error : null; %>
                    <div class="container">
                        <h1>Book Search</h1>
                        <p>Search OpenLibrary by title, author, or both.</p>

                        <form method="get" action="/book/search">
                            <div class="row mb-3 mt-3">
                                <div class="col-md-6 mb-3">
                                    <label for="title"
                                        class="form-label fw-semibold book-search-label text-left">Title</label>
                                    <input id="title" name="title" type="text" value="<%= safeSearch.title || '' %>"
                                        class="form-control form-control-lg">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="author"
                                        class="form-label fw-semibold book-search-label text-left">Author</label>
                                    <input id="author" name="author" type="text" value="<%= safeSearch.author || '' %>"
                                        class="form-control form-control-lg">
                                </div>
                                <div class="col-6 mx-auto">
                                    <button type="submit" class="btn btn-primary w-100">Search</button>
                                </div>

                                <!-- <button type="submit" class="btn btn-primary">Search</button> -->
                            </div>

                        </form>

                        <% if (safeError) { %>
                            <p style="color: #b00020;">
                                <%= safeError %>
                            </p>
                            <% } %>

                                <h2>Results (<%= safeResults.length %>)</h2>

                                <form method="POST" action="/book/save" class="row justify-content-center g-4 mt-2">
                                    <% if (safeResults.length> 0) { %>
                                        <% safeResults.forEach((book)=> { %>
                                            <div class="col-md-5 col-lg-4">
                                                <div class="card book-card p-4 h-100 book-item"
                                                    data-id="<%= book.key %>">

                                                    <% if (book.coverUrl && book.coverUrl.trim() !=='' ) { %>
                                                        <img src="<%= book.coverUrl.trim() %>"
                                                            alt="Cover for <%= book.title %>" class="book-cover"
                                                            data-cover-url="<%= book.coverUrl %>"
                                                            onerror="this.onerror=null; this.src='/img/missing-book-transparent.png';">

                                                        <% } else { %>

                                                            <img src="/img/missing-book-transparent.png"
                                                                data-cover-url="<%= book.coverUrl %>"
                                                                alt="No cover available" class="book-cover">

                                                            <% } %>

                                                                <div name="title" data-title="<%= book.title %>">
                                                                    <h2>
                                                                        <%= book.title %>
                                                                    </h2>
                                                                </div>
                                                                <div name="author" data-author="<%= book.author %>">
                                                                    <p>
                                                                        <strong>Author:</strong>
                                                                        <%= book.author %>
                                                                    </p>
                                                                </div>

                                                                <div name="year"
                                                                    data-year="<%= book.year || 'Unknown year' %>">
                                                                    <p><strong>Year:</strong>
                                                                        <%= book.year || 'Unknown year' %>
                                                                    </p>
                                                                </div>
                                                                <div name="isbn" data-isbn="<%= book.isbn %>">
                                                                    <p><strong>ISBN:</strong>
                                                                        <%= book.isbn || 'Unknown ISBN' %>
                                                                    </p>
                                                                </div>
                                                                <button name="editionKey"
                                                                    data-edition-key="<%= book.editionKey %>"
                                                                    class="btn btn-primary">Save
                                                                    Book</button>
                                                </div>
                                            </div>
                                            <% }); %>
                                                <% }; %>
                                </form>
                    </div>
                    <div class="toast-container position-fixed bottom-0 end-0 p-3">
                        <div id="liveToast" class="toast  " role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="toast-header">
                                <!-- <img src="..." class="rounded me-2" alt="..."> -->
                                <strong class="me-auto" id="toastTitle">Author Admin</strong>
                                <small id="toastTitleAction">Delete Author</small>
                                <button type="button" class="btn-close" data-bs-dismiss="toast"
                                    aria-label="Close"></button>
                            </div>
                            <div class="toast-body" id="toastMsgBody">
                                msg body
                            </div>
                        </div>
                    </div>
                    <script src="/js/book.js"></script>

                    <a href="/dashboard">Back to Dashboard</a>

                    <%- include("../partials/footer") %>
</body>

</html>