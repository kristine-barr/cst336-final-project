<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- add the partials for head and footer. this is a dem -->
    <title>My Library - Edit Book Info</title>
</head>
<body>

    <h2><%= book.title %></h2>

<form method="POST" action="/book/edit">

        <input
            type="hidden"
            name="userBookId"
            value="<%= book.userBookId %>"
        >
        Set Status:
    <label>
        <input
            type="radio"
            name="readingStatus"
            value="Want to Read"
            <%= book.readingStatus === "Want to Read" ? "checked" : "" %>
        >
        Want to Read
    </label>

    <label>
        <input
            type="radio"
            name="readingStatus"
            value="Reading"
            <%= book.readingStatus === "Reading" ? "checked" : "" %>
        >
        Reading
    </label>

    <label>
        <input
            type="radio"
            name="readingStatus"
            value="Finished"
            <%= book.readingStatus === "Finished" ? "checked" : "" %>
        >
        Finished
    </label>
        <br>
        Set Rating:
        <label>
        <input 
            type="radio"
            name="rating"
            value=""
            <%= book.rating == null ? "checked" : "" %>
            >
        Unrated
    </label>

    <label><input 
        type="radio" 
        name="rating" 
        value="1"
        <%= book.rating === 1 ? "checked" : "" %>
        > 1</label>
    <label><input 
        type="radio" 
        name="rating" 
        value="2"
        <%= book.rating === 2 ? "checked" : "" %>
        > 2</label>
    <label><input 
        type="radio" 
        name="rating" 
        value="3"
        <%= book.rating === 3 ? "checked" : "" %>
        > 3</label>
    <label><input 
        type="radio" 
        name="rating" 
        value="4"
        <%= book.rating === 4 ? "checked" : "" %>
        > 4</label>
    <label><input 
        type="radio" 
        name="rating" 
        value="5"
        <%= book.rating === 5 ? "checked" : "" %>
        > 5</label>

        <button type="submit">Update Status</button>
    </form>

    <a href="/dashboard">Back to Dashboard</a>
</body>
</html>