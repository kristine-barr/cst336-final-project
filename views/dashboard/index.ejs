<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="hero">

        <img src="/img/welcome-logo.png" alt="Open book illustration">

        <p>Manage your personal bookshelf and discover new books.</p>
    </div>

    <div class="dashboard-options">

        <div class="dashboard-card">

            <h2>My Library</h2>

            <p>View and manage the books you have saved.</p>
            <a href="/library">View My Library </a>

        </div>

        <div class="dashboard-card">

            <h2>Search Books</h2>

            <p>Search for books and add them to your collection.</p>
            <a href="/book">Search Books</a>

        </div>

    </div>

</body>

</html>