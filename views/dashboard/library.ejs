<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head") %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Library</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="d-flex flex-column min-vh-100">

    <%- include("../partials/nav") %>

    <div class="container">

        <h1 class="text-center">My Library</h1>

        <% if (successMessage) { %>
            <div class="alert alert-success" role="alert">
                <%= successMessage %>
            </div>
        <% } %>

        <p class="text-center">View and manage your saved books.</p>

        <% if (books.length === 0) { %>

            <p class="text-center">You have not added any books yet.</p>

        <% } else { %>

            <div class="row justify-content-center g-4 mt-2">

                <% for (let i = 0; i < books.length; i++) { %>

                    <div class="col-md-5 col-lg-4">

                        <div class="card book-card p-4 h-100">

                            <% if (books[i].bookCoverUrl) { %>

                                <img
                                    src="<%= books[i].bookCoverUrl.trim() %>"
                                    alt="Cover for <%= books[i].title %>"
                                    class="book-cover"
                                    onerror="this.onerror=null; this.src='/img/missing-book-transparent.png';">

                            <% } else { %>

                                <img
                                    src="/img/missing-book-transparent.png"
                                    alt="No cover available"
                                    class="book-cover">

                            <% } %>

                            <h2>
                                <%= books[i].title %>
                            </h2>

                            <p>
                                <strong>Author:</strong>
                                <%= books[i].author %>
                            </p>

                            <p>
                                <strong>Published:</strong>
                                <%= books[i].publishYear %>
                            </p>

                            <p>
                                <strong>ISBN:</strong>
                                <%= books[i].isbn %>
                            </p>

                            <p>
                                <strong>Status:</strong>
                                <%= books[i].readingStatus %>
                            </p>

                            <p>
                                <strong>Rating:</strong>
                                <%= books[i].rating %>
                            </p>

                            <p>
                                <strong>Categories:</strong>

                                <% if (books[i].categories) { %>
                                    <%= books[i].categories %>
                                <% } else { %>
                                    None
                                <% } %>
                            </p>

                            <div class="d-flex gap-2 mt-auto">

                                <a
                                    href="/book/edit?userBookId=<%= books[i].userBookId %>"
                                    class="btn btn-primary">
                                    Edit
                                </a>

                                <form method="POST" action="/library/delete">

                                    <input
                                        type="hidden"
                                        name="userBookId"
                                        value="<%= books[i].userBookId %>">

                                    <button
                                        type="submit"
                                        class="btn btn-outline-danger"
                                        onclick="return confirm('Remove this book from your library?')">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                <% } %>

            </div>

        <% } %>

    </div>
    
<%- include("../partials/footer") %>
</body>

</html>